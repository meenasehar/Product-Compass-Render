# ── Jira DC ───────────────────────────────────────────────────────────────────
# Generate a PAT: Jira → Profile → Personal Access Tokens
JIRA_BASE_URL=https://jira-dc.paloaltonetworks.com
JIRA_PAT=
JIRA_PROJECT=PSDWPM

# ── Confluence DC ─────────────────────────────────────────────────────────────
CONFLUENCE_BASE_URL=https://confluence.paloaltonetworks.com
CONFLUENCE_PAT=

# ── Google OAuth (one-time admin setup — PMs never see this) ──────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/callback
ALLOWED_DOMAIN=paloaltonetworks.com

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ── Jira custom field IDs (discover via GET /api/jira/fields after first run) ──
# JIRA_FIELD_PILLAR=customfield_XXXXX
# JIRA_FIELD_PRODUCT_COMPONENT=customfield_XXXXX
